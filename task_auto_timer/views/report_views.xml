<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <!-- ── Unified list view ────────────────────────────────── -->
    <record id="view_tat_report_unified_list" model="ir.ui.view">
        <field name="name">tat.report.unified.list</field>
        <field name="model">tat.report</field>
        <field name="arch" type="xml">
            <list
                string="Task Timer Report"
                create="false"
                delete="false"
                default_order="project_id, total_hours desc"
            >
                <field name="project_id"         string="Project"     optional="show" />
                <field name="user_id"            string="Employee"    optional="show" />
                <field name="display_name_custom" string="Task"       optional="show" />
                <field name="stage_id"           string="Stage"       optional="show" />
                <field name="task_count"         string="Tasks"       optional="show" />
                <field name="total_hours"        string="Hours Spent"
                       widget="float_time"       optional="show" />
                <field name="sale_price"         string="Sale Price"
                       widget="monetary"         optional="hide" />
                <field name="cost_price"         string="Cost Price"
                       widget="monetary"         optional="show" />
                <field name="is_cto"             string="CTO Test"    optional="show" />

                <!-- Yashirin texnik fieldlar -->
                <field name="currency_id" column_invisible="1" />
                <field name="level"       column_invisible="1" />
            </list>
        </field>
    </record>

    <!-- ── Search view ──────────────────────────────────────── -->
    <record id="view_tat_report_search" model="ir.ui.view">
        <field name="name">tat.report.search</field>
        <field name="model">tat.report</field>
        <field name="arch" type="xml">
            <search string="Search Timer Report">

                <field name="project_id" string="Project"  />
                <field name="user_id"    string="Employee" />
                <field name="stage_id"   string="Stage"    />

                <separator />

                <filter
                    string="Tasks"
                    name="filter_task"
                    domain="[('level','=','task')]"
                />
                <filter
                    string="CTO Test vaqti"
                    name="filter_cto"
                    domain="[('is_cto','=',True)]"
                />

                <separator />

                <filter
                    string="Group by Project"
                    name="group_project"
                    context="{'group_by': 'project_id'}"
                />
                <filter
                    string="Group by Employee"
                    name="group_employee"
                    context="{'group_by': 'user_id'}"
                />
                <filter
                    string="Group by Stage"
                    name="group_stage"
                    context="{'group_by': 'stage_id'}"
                />

            </search>
        </field>
    </record>

    <!-- ── Server action ────────────────────────────────────── -->
    <record id="action_tat_report" model="ir.actions.server">
        <field name="name">Task Timer Report</field>
        <field name="model_id" ref="model_tat_report" />
        <field name="state">code</field>
        <field name="code">action = model.action_open_report()</field>
    </record>

</odoo>
